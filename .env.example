# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored; this file is committed as a template.

# Ola Maps API key — https://maps.olakrutrim.com
VITE_OLA_MAPS_API_KEY=your-ola-maps-key-here

# Optional: Google Maps Embed API key, for Street View of venues (free, no usage limit).
# Restrict it to your site's domain in Google Cloud Console.
VITE_GOOGLE_MAPS_EMBED_KEY=your-google-embed-key-here
